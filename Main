local function Heads()
    while task.wait(0.5) do
        local he = {}
        for _, v in next, special:GetDescendants() do
            if v:IsA("SpecialMesh") and v.Parent and v.Parent.Name == "Head" then
                table.insert(he, v)
                if #he == 20 then
                    break
                end
            end
        end
        if #he == 0 then
            break
        end
        del:InvokeServer(he)
        local a = del.Parent.Undo:InvokeServer()
        if a ~= true then
            warn("not true")
        end
        warn("undo done?")
    end
end

